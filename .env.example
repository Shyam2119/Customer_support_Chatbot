# Customer Support Chatbot - Environment Configuration
# Copy this file to .env and update values

# Flask
SECRET_KEY=your-secret-key-change-in-production-please
DEBUG=true
HOST=0.0.0.0
PORT=5000

# Admin API Key (for /api/admin/* endpoints)
ADMIN_API_KEY=demo-admin-key-12345

# Database
DB_PATH=data/chatbot.db

# Model

# The intent threshold is chosen automatically by scripts/evaluate.py

# Optional: answer out-of-scope questions with Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/chatbot.log
